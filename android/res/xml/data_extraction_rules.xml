<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the cloud copy stays small (main data + settings); a phone-to-phone transfer brings every backup too. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="cariler.json" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
