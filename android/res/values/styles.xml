<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#F2F3F7</color>
    <color name="icon_bg">#0B4650</color>
    <!-- Starts on denim (same as the icon) so the launch animation follows the system splash without a flash. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/icon_bg</item>
        <item name="android:windowSplashScreenBackground">@color/icon_bg</item>
        <item name="android:colorPrimary">#24337F</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="android:statusBarColor">@color/icon_bg</item>
        <item name="android:navigationBarColor">@color/icon_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
